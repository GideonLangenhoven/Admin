diff --git a/app/globals.css b/app/globals.css
index 9bf969d..7b6fe99 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -914,3 +914,134 @@
   color: var(--accent-text) !important;
   text-decoration: underline;
 }
+
+/* Shared guest departure picker: quiet dates, one deliberate selection. */
+.guest-calendar {
+  padding: 1rem 0.25rem;
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-lg);
+  background: var(--glass-solid-card);
+  color: var(--ink);
+}
+
+.guest-calendar-grid {
+  display: grid;
+  grid-template-columns: repeat(7, minmax(0, 1fr));
+  gap: 0.25rem;
+}
+
+.guest-calendar-day {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  max-width: 3rem;
+  min-width: 0;
+  min-height: 2.75rem;
+  aspect-ratio: 1;
+  justify-self: center;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--ink);
+  font-size: 0.9375rem;
+  font-weight: 500;
+  font-variant-numeric: tabular-nums;
+}
+
+.guest-calendar-day[data-unavailable="true"] {
+  color: var(--ink-faint);
+  text-decoration: line-through;
+  cursor: not-allowed;
+}
+
+.guest-calendar-day[aria-pressed="true"] {
+  background-color: var(--accent);
+  background-image: linear-gradient(var(--main-overlay), var(--main-overlay));
+  color: var(--ink-on-main);
+  font-weight: 600;
+}
+
+.guest-calendar-day[aria-pressed="true"][data-unavailable="true"] {
+  opacity: 0.55;
+}
+
+.guest-calendar-nav {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 2.75rem;
+  height: 2.75rem;
+  flex-shrink: 0;
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-sm);
+  color: var(--ink);
+}
+
+.guest-calendar-nav:disabled {
+  opacity: 0.3;
+  cursor: not-allowed;
+}
+
+.guest-departure-choice {
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-sm);
+  background: transparent;
+}
+
+.guest-departure-choice + .guest-departure-choice {
+  margin-top: 0.5rem;
+}
+
+.guest-departure-choice[aria-pressed="true"] {
+  border-color: var(--accent-text);
+  background: color-mix(in srgb, var(--accent) 8%, var(--glass-solid-card));
+}
+
+@media (hover: hover) {
+  .guest-calendar-day:not(:disabled):not([aria-pressed="true"]):hover,
+  .guest-calendar-nav:not(:disabled):hover,
+  .guest-departure-choice:not(:disabled):not([aria-pressed="true"]):hover {
+    background: var(--hover-overlay);
+  }
+}
+
+/* Inset focus cannot collide with adjacent dates, even at 320px. */
+.guest-calendar button:focus-visible {
+  outline: 2px solid var(--ink);
+  outline-offset: -3px;
+  box-shadow: none;
+}
+
+.guest-calendar-day[aria-pressed="true"]:focus-visible {
+  outline-color: var(--ink-on-main);
+}
+
+.guest-departure-choice:focus-visible {
+  outline: 2px solid var(--ink);
+  outline-offset: 2px;
+  box-shadow: none;
+}
+
+@media (min-width: 360px) {
+  .guest-calendar { padding-inline: 0.75rem; }
+}
+
+@media (min-width: 640px) {
+  .guest-calendar { padding: 1rem; }
+}
+
+@media (min-width: 1024px) {
+  .guest-calendar { padding: 1.5rem; }
+  .guest-calendar-grid { gap: 0.375rem; }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .guest-calendar-day,
+  .guest-calendar-nav,
+  .guest-departure-choice {
+    transition: background-color var(--dur-fast) var(--ease-soft),
+      border-color var(--dur-fast) var(--ease-soft),
+      color var(--dur-fast) var(--ease-soft);
+  }
+}
