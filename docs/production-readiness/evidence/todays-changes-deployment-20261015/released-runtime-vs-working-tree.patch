+    booking_id: bk.id,
+    event: "gyg_booking_cancelled",
+    payload: { external_ref: ref },
+  });
+
+  console.log("GYG_WEBHOOK: booking cancelled id=" + bk.id + " ref=" + ref);
+  return respond(200, { ok: true, cancelled: bk.id }, origin);
+}
