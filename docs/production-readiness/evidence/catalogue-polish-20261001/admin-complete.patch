@@ -0,0 +1,408 @@
+/* Shared catalogue presentation. Keep the admin's components/booking copy
+   identical: the two apps deploy from separate repositories. */
+.catalogue-page,
+.catalogue-footer,
+.catalogue-preview {
+  --catalogue-space: 0.25rem;
+  --catalogue-radius: 0.75rem;
+  --catalogue-border: color-mix(in srgb, var(--catalogue-ink, var(--ink)) 14%, transparent);
+}
+
+.catalogue-page {
+  --ink: var(--catalogue-ink);
+  --ink-muted: var(--catalogue-muted);
+  padding-block: calc(var(--catalogue-space) * 6);
+}
+
+.catalogue-footer {
+  --ink: var(--catalogue-ink);
+  --ink-muted: var(--catalogue-muted);
+}
+
+.catalogue-footer .catalogue-surface { color: var(--catalogue-muted); }
+
+/* Existing resume, deal and combo panels use the same restrained surfaces. */
+.catalogue-page .glass {
+  border-radius: var(--catalogue-radius);
+  background: var(--catalogue-surface);
+  box-shadow: 0 2px 6px rgb(0 0 0 / 0.05);
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
+
+.catalogue-page .glass-chip {
+  border-radius: 0.5rem;
+  background: transparent;
+  box-shadow: none;
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
+
+.catalogue-page .glass-hover:hover { transform: none; }
+.catalogue-page .btn {
+  min-height: 2.75rem;
+  border-radius: 0.5rem;
+  white-space: normal;
+  box-shadow: none;
+}
+
+.catalogue-page .btn-primary:hover { filter: none; text-decoration: underline; }
+
+.catalogue-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: calc(var(--catalogue-space) * 6);
+}
+
+.catalogue-card,
+.catalogue-surface {
+  min-width: 0;
+  border: 1px solid var(--catalogue-border);
+  border-radius: var(--catalogue-radius);
+  background: var(--catalogue-surface, var(--cfg-bg, var(--bg)));
+  color: var(--catalogue-ink, var(--ink));
+  box-shadow: 0 2px 6px rgb(0 0 0 / 0.05);
+}
+
+.catalogue-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  text-align: left;
+}
+
+.catalogue-photo {
+  position: relative;
+  flex-shrink: 0;
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  border-radius: calc(var(--catalogue-radius) - 1px) calc(var(--catalogue-radius) - 1px) 0 0;
+}
+
+.catalogue-photo img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+}
+
+.catalogue-card-content {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: calc(var(--catalogue-space) * 3);
+  padding: calc(var(--catalogue-space) * 4);
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.catalogue-card h3 {
+  margin: 0;
+  color: inherit;
+  font-family: var(--font-display, inherit);
+  font-size: 1.25rem;
+  font-weight: 600;
+  line-height: 1.35;
+  letter-spacing: -0.015em;
+}
+
+.catalogue-card-details {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: calc(var(--catalogue-space) * 2) calc(var(--catalogue-space) * 4);
+  margin-top: calc(var(--catalogue-space) * 2);
+}
+
+.catalogue-price {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: calc(var(--catalogue-space) * 2);
+  margin: 0 0 0 auto;
+  color: var(--catalogue-ink, var(--ink));
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1.5;
+  font-variant-numeric: tabular-nums;
+}
+
+.catalogue-price span,
+.catalogue-supporting,
+.catalogue-description {
+  margin-block: 0;
+  color: var(--catalogue-muted, var(--ink-muted));
+  font-size: 0.875rem;
+  font-weight: 400;
+  line-height: 1.55;
+}
+
+.catalogue-availability {
+  margin: 0;
