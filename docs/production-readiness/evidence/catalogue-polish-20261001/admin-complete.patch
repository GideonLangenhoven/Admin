+import { Inter, Quicksand } from "next/font/google";
+import type { CSSProperties } from "react";
+import { computeTheme } from "../../app/lib/theme-engine";
+import { formatDuration } from "../../app/lib/duration";
+import { CatalogueCard, CatalogueIntro } from "./Catalogue";
+
+// The storefront's existing font defaults. Keep the preview's display token
+// scoped here so it cannot change the admin application's typography.
+const body = Inter({ subsets: ["latin"] });
+const display = Quicksand({ subsets: ["latin"], weight: ["500", "600", "700"], variable: "--font-display" });
+
+type PreviewTour = {
+  id: string;
+  name: string;
+  duration_minutes: number | null;
+  base_price_per_person: number | null;
+  description: string | null;
+  image_url: string | null;
+  active: boolean;
+  hidden: boolean;
+};
+type PreviewSettings = Partial<Record<
+  "color_main" | "color_secondary" | "color_cta" | "color_bg" | "color_nav" | "color_hover" |
+  "business_name" | "business_tagline" | "logo_url" | "booking_site_url" |
+  "hero_title" | "hero_eyebrow" | "hero_subtitle" | "hero_image" |
+  "nav_gift_voucher_label" | "nav_my_bookings_label" | "card_cta_label" |
+  "footer_line_one" | "footer_line_two" | "chat_widget_label", string | null
+>>;
+
+export default function BookingSitePreview({ siteSettings, tours }: { siteSettings: PreviewSettings; tours: PreviewTour[] }) {
+  const theme = computeTheme({
+    main: siteSettings.color_main, secondary: siteSettings.color_secondary,
+    cta: siteSettings.color_cta, bg: siteSettings.color_bg,
+    nav: siteSettings.color_nav, hover: siteSettings.color_hover,
+  });
+  const name = siteSettings.business_name || "Book Your Tour";
+  const base = (siteSettings.booking_site_url || "").replace(/\/+$/, "");
+  const actionLabel = siteSettings.card_cta_label || "Book Now";
+  const visibleTours = tours.filter(tour => tour.active && !tour.hidden);
+
+  return (
+    <div>
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-2 pb-2 border-b border-[var(--ck-border-subtle)]">
+        <h3 className="text-sm font-semibold text-[var(--ck-text-strong)]">Booking Page Preview</h3>
+        {base && <a href={base} target="_blank" rel="noopener noreferrer" className="text-sm text-[var(--ck-accent)] underline underline-offset-2">Open booking page</a>}
+      </div>
+      <p className="text-xs text-[var(--ck-text-muted)] mb-4">Live layout preview using your visible tours and current settings. Text colours adjust automatically for readability.</p>
+      <div className={`catalogue-preview ${body.className} ${display.variable}`} style={theme.vars as CSSProperties} data-booking-preview>
+        <div className="catalogue-backdrop" aria-hidden="true">
+          <div className="glass-backdrop-mesh" />
+          {siteSettings.hero_image && (
+            // eslint-disable-next-line @next/next/no-img-element
+            <img src={siteSettings.hero_image} alt="" loading="lazy" />
+          )}
+        </div>
+        <div className="catalogue-header">
+          <div className="catalogue-header-content">
+            <a className="catalogue-brand" href={base || undefined} target="_blank" rel="noopener noreferrer">
+              {siteSettings.logo_url ? (
+                // eslint-disable-next-line @next/next/no-img-element
+                <img src={siteSettings.logo_url} alt={name} />
+              ) : <span className="catalogue-monogram" aria-hidden="true">{name.trim().charAt(0).toUpperCase() || "B"}</span>}
+              <div className="min-w-0">
+                <div className="catalogue-brand-name">{name}</div>
+                {siteSettings.business_tagline && <p>{siteSettings.business_tagline}</p>}
+              </div>
+            </a>
+            <nav className="catalogue-nav" aria-label="Booking preview">
+              <a href={base ? base + "/voucher" : undefined} target="_blank" rel="noopener noreferrer">{siteSettings.nav_gift_voucher_label || "Gift Voucher"}</a>
+              <a href={base ? base + "/my-bookings" : undefined} target="_blank" rel="noopener noreferrer">{siteSettings.nav_my_bookings_label || "My Bookings"}</a>
+            </nav>
+          </div>
+        </div>
+        <div className="catalogue-preview-content">
+          <CatalogueIntro title={siteSettings.hero_title} eyebrow={siteSettings.hero_eyebrow} subtitle={siteSettings.hero_subtitle} />
+          <div className="catalogue-grid">
+            {visibleTours.map(tour => (
+              <CatalogueCard key={tour.id} name={tour.name} duration={formatDuration(tour.duration_minutes)}
+                price={tour.base_price_per_person} description={tour.description}
+                image={tour.image_url ? (
+                  // eslint-disable-next-line @next/next/no-img-element
+                  <img src={tour.image_url} alt={tour.name + " tour"} loading="lazy" />
+                ) : undefined}
+                action={base ? (
+                  <a href={base + "/book?tour=" + tour.id} className="catalogue-action" target="_blank" rel="noopener noreferrer" aria-label={`${actionLabel}: ${tour.name}`}>{actionLabel}</a>
+                ) : <span className="catalogue-action">{actionLabel}</span>} />
+            ))}
+          </div>
+          {visibleTours.length === 0 && <p className="catalogue-surface catalogue-preview-content catalogue-description">Your visible tours will appear here.</p>}
+          <div className="catalogue-surface catalogue-preview-footer">
+            <p className="catalogue-description">{siteSettings.footer_line_one || (name + (siteSettings.business_tagline ? " · " + siteSettings.business_tagline : ""))}</p>
+            {siteSettings.footer_line_two && <p className="catalogue-description">{siteSettings.footer_line_two}</p>}
+            <span className="catalogue-supporting">{siteSettings.chat_widget_label || "Book here"}</span>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
--- a/components/booking/Catalogue.tsx
+++ b/components/booking/Catalogue.tsx
@@ -0,0 +1,51 @@
+import type { ReactNode } from "react";
+import "./catalogue.css";
+
+// Presentation only. The public catalogue supplies its existing price and
+// booking URL; the admin preview carries an identical copy across repo builds.
+export function CatalogueCard({ name, duration, price, description, image, reviews, urgency, action }: {
+  name: string;
+  duration: string;
+  price: number | null | undefined;
+  description?: string | null;
+  image?: ReactNode;
+  reviews?: string;
+  urgency?: string | null;
+  action: ReactNode;
+}) {
+  return (
+    <article className="catalogue-card" data-shot="tour-card">
+      {image && <div className="catalogue-photo">{image}</div>}
+      <div className="catalogue-card-content">
+        <div className="catalogue-card-heading">
+          <h3>{name}</h3>
+          <div className="catalogue-card-details">
+            <span className="catalogue-supporting">{duration}</span>
+            {typeof price === "number" && Number.isFinite(price) && (
+              <p className="catalogue-price">R{price}<span>per person</span></p>
+            )}
+          </div>
+        </div>
+        {reviews && <p className="catalogue-supporting">{reviews}</p>}
+        {urgency && <p className="catalogue-availability">{urgency}</p>}
+        <div className="catalogue-card-action">{action}</div>
+        {description && <p className="catalogue-description">{description}</p>}
+      </div>
+    </article>
+  );
+}
+
+export function CatalogueIntro({ title, eyebrow, subtitle }: {
+  title?: string | null;
+  eyebrow?: string | null;
+  subtitle?: string | null;
+}) {
+  if (!title?.trim()) return null;
+  return (
+    <div className="catalogue-intro catalogue-surface">
+      {eyebrow && <p className="catalogue-supporting">{eyebrow}</p>}
+      <h2>{title}</h2>
+      {subtitle && <p className="catalogue-description">{subtitle}</p>}
+    </div>
+  );
+}
