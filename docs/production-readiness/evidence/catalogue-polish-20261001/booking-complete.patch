@@ -0,0 +1,51 @@
+import type { ReactNode } from "react";
+import "./catalogue.css";
+
+// Presentation only. The public catalogue supplies its existing price and
+// booking URL; the admin preview carries an identical copy across repo builds.
+export function CatalogueCard({ name, duration, price, description, image, reviews, urgency, action }: {
+  name: string;
+  duration: string;
+  price: number | null | undefined;
+  description?: string | null;
+  image?: ReactNode;
+  reviews?: string;
+  urgency?: string | null;
+  action: ReactNode;
+}) {
+  return (
+    <article className="catalogue-card" data-shot="tour-card">
+      {image && <div className="catalogue-photo">{image}</div>}
+      <div className="catalogue-card-content">
+        <div className="catalogue-card-heading">
+          <h3>{name}</h3>
+          <div className="catalogue-card-details">
+            <span className="catalogue-supporting">{duration}</span>
+            {typeof price === "number" && Number.isFinite(price) && (
+              <p className="catalogue-price">R{price}<span>per person</span></p>
+            )}
+          </div>
+        </div>
+        {reviews && <p className="catalogue-supporting">{reviews}</p>}
+        {urgency && <p className="catalogue-availability">{urgency}</p>}
+        <div className="catalogue-card-action">{action}</div>
+        {description && <p className="catalogue-description">{description}</p>}
+      </div>
+    </article>
+  );
+}
+
+export function CatalogueIntro({ title, eyebrow, subtitle }: {
+  title?: string | null;
+  eyebrow?: string | null;
+  subtitle?: string | null;
+}) {
+  if (!title?.trim()) return null;
+  return (
+    <div className="catalogue-intro catalogue-surface">
+      {eyebrow && <p className="catalogue-supporting">{eyebrow}</p>}
+      <h2>{title}</h2>
+      {subtitle && <p className="catalogue-description">{subtitle}</p>}
+    </div>
+  );
+}
