@@ -0,0 +1,408 @@
+/* Shared catalogue presentation. Keep the admin's components/booking copy
+   identical: the two apps deploy from separate repositories. */
+.catalogue-page,
+.catalogue-footer,
+.catalogue-preview {
+  --catalogue-space: 0.25rem;
+  --catalogue-radius: 0.75rem;
+  --catalogue-border: color-mix(in srgb, var(--catalogue-ink, var(--ink)) 14%, transparent);
+}
+
+.catalogue-page {
+  --ink: var(--catalogue-ink);
+  --ink-muted: var(--catalogue-muted);
+  padding-block: calc(var(--catalogue-space) * 6);
+}
+
+.catalogue-footer {
+  --ink: var(--catalogue-ink);
+  --ink-muted: var(--catalogue-muted);
+}
+
+.catalogue-footer .catalogue-surface { color: var(--catalogue-muted); }
+
+/* Existing resume, deal and combo panels use the same restrained surfaces. */
+.catalogue-page .glass {
+  border-radius: var(--catalogue-radius);
+  background: var(--catalogue-surface);
+  box-shadow: 0 2px 6px rgb(0 0 0 / 0.05);
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
+
+.catalogue-page .glass-chip {
+  border-radius: 0.5rem;
+  background: transparent;
+  box-shadow: none;
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
+
+.catalogue-page .glass-hover:hover { transform: none; }
+.catalogue-page .btn {
+  min-height: 2.75rem;
+  border-radius: 0.5rem;
+  white-space: normal;
+  box-shadow: none;
+}
+
+.catalogue-page .btn-primary:hover { filter: none; text-decoration: underline; }
+
+.catalogue-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: calc(var(--catalogue-space) * 6);
+}
+
+.catalogue-card,
+.catalogue-surface {
+  min-width: 0;
+  border: 1px solid var(--catalogue-border);
+  border-radius: var(--catalogue-radius);
+  background: var(--catalogue-surface, var(--cfg-bg, var(--bg)));
+  color: var(--catalogue-ink, var(--ink));
+  box-shadow: 0 2px 6px rgb(0 0 0 / 0.05);
+}
+
+.catalogue-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  text-align: left;
+}
+
+.catalogue-photo {
+  position: relative;
+  flex-shrink: 0;
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  border-radius: calc(var(--catalogue-radius) - 1px) calc(var(--catalogue-radius) - 1px) 0 0;
+}
+
+.catalogue-photo img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+}
+
+.catalogue-card-content {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: calc(var(--catalogue-space) * 3);
+  padding: calc(var(--catalogue-space) * 4);
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.catalogue-card h3 {
+  margin: 0;
+  color: inherit;
+  font-family: var(--font-display, inherit);
+  font-size: 1.25rem;
+  font-weight: 600;
+  line-height: 1.35;
+  letter-spacing: -0.015em;
+}
+
+.catalogue-card-details {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: calc(var(--catalogue-space) * 2) calc(var(--catalogue-space) * 4);
+  margin-top: calc(var(--catalogue-space) * 2);
+}
+
+.catalogue-price {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: calc(var(--catalogue-space) * 2);
+  margin: 0 0 0 auto;
+  color: var(--catalogue-ink, var(--ink));
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1.5;
+  font-variant-numeric: tabular-nums;
+}
+
+.catalogue-price span,
+.catalogue-supporting,
+.catalogue-description {
+  margin-block: 0;
+  color: var(--catalogue-muted, var(--ink-muted));
+  font-size: 0.875rem;
+  font-weight: 400;
+  line-height: 1.55;
+}
+
+.catalogue-availability {
+  margin: 0;
+  color: var(--catalogue-ink, var(--ink));
+  font-size: 0.875rem;
+  font-weight: 600;
+  line-height: 1.5;
+}
+
+.catalogue-action {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  min-height: 2.75rem;
+  padding: calc(var(--catalogue-space) * 3) calc(var(--catalogue-space) * 4);
+  border: 1px solid transparent;
+  border-radius: 0.5rem;
+  background-color: var(--cta);
+  background-image: linear-gradient(var(--cta-overlay), var(--cta-overlay));
+  color: var(--ink-on-cta);
+  font-size: 0.875rem;
+  font-weight: 600;
+  line-height: 1.5;
+  text-align: center;
+  text-decoration: none;
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+
+/* One link and one tab stop per tour. Its hit area includes the card. */
+.catalogue-card .catalogue-action::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: var(--catalogue-radius);
+}
+
+.catalogue-action:focus-visible {
+  outline: 2px solid var(--catalogue-ink, var(--ink));
+  outline-offset: 3px;
+  box-shadow: none;
+}
+
+.catalogue-card .catalogue-action:focus-visible::after {
+  outline: 2px solid var(--catalogue-ink, var(--ink));
+  outline-offset: 3px;
+}
+
+.catalogue-intro {
+  display: grid;
+  gap: calc(var(--catalogue-space) * 2);
+  margin-bottom: calc(var(--catalogue-space) * 6);
+  padding: calc(var(--catalogue-space) * 4);
+  overflow-wrap: anywhere;
+}
+
+.catalogue-intro h2 {
+  margin: 0;
+  color: inherit;
+  font-family: var(--font-display, inherit);
+  font-size: 1.75rem;
+  font-weight: 600;
+  line-height: 1.25;
+}
+
+.catalogue-header {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  border-bottom: 1px solid color-mix(in srgb, var(--catalogue-nav-ink, var(--ink-nav)) 14%, transparent);
+  background: var(--catalogue-nav-surface, var(--cfg-nav, var(--surface)));
+  color: var(--catalogue-nav-ink, var(--ink-nav));
+}
+
+.catalogue-header-content {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  padding-block: 0.75rem;
+}
+
+.catalogue-brand {
+  display: flex;
+  flex: 1 1 12rem;
+  align-items: center;
+  gap: 0.75rem;
+  min-width: 0;
+  color: inherit;
+  text-decoration: none;
+  overflow-wrap: anywhere;
+}
+
+.catalogue-brand img {
+  width: auto;
+  height: auto;
+  max-width: 6rem;
+  max-height: 2.25rem;
+  object-fit: contain;
+}
+
+.catalogue-monogram {
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  justify-content: center;
+  width: 2.25rem;
+  height: 2.25rem;
+  border: 1px solid currentColor;
+  border-radius: 0.5rem;
+  font-weight: 600;
+}
+
+.catalogue-brand h1,
+.catalogue-brand-name {
+  margin: 0;
+  color: inherit;
+  font-family: var(--font-display, inherit);
+  font-size: 1.125rem;
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.catalogue-brand p {
+  margin: 0;
+  color: inherit;
+  font-size: 0.875rem;
+  line-height: 1.5;
+}
+
+.catalogue-nav {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.25rem;
+  min-width: 0;
+}
+
+.catalogue-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 2.75rem;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid transparent;
+  border-radius: 0.5rem;
+  color: inherit;
+  font-size: 0.875rem;
+  font-weight: 500;
+  line-height: 1.5;
+  text-decoration: none;
+  overflow-wrap: anywhere;
+}
+
+.catalogue-brand:focus-visible,
+.catalogue-nav a:focus-visible {
+  outline: 2px solid var(--catalogue-nav-ink, var(--ink-nav));
+  outline-offset: 2px;
+  box-shadow: none;
+}
+
+/* The uploaded photo stays intact. This treatment only quiets the backdrop. */
+.catalogue-backdrop .glass-backdrop-mesh {
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(90% 70% at 12% 8%, color-mix(in srgb, var(--cfg-main) 16%, transparent), transparent 62%),
+    radial-gradient(80% 65% at 88% 18%, color-mix(in srgb, var(--cfg-hover) 10%, transparent), transparent 64%),
+    var(--cfg-bg);
+}
+
+.catalogue-backdrop .glass-backdrop-mesh::after { content: none; }
+.catalogue-backdrop::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: color-mix(in srgb, var(--cfg-bg) 24%, transparent);
+}
+
+.catalogue-preview {
+  position: relative;
+  isolation: isolate;
+  border: 1px solid var(--ck-border-subtle);
+  border-radius: var(--catalogue-radius);
+  overflow: hidden;
+  container-type: inline-size;
+  background: var(--cfg-bg);
+}
+
+.catalogue-preview .catalogue-backdrop {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+}
+
+.catalogue-preview .catalogue-backdrop img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  filter: blur(2px);
+}
+
+.catalogue-preview .catalogue-header { position: relative; z-index: auto; }
+.catalogue-preview .catalogue-header-content { padding-inline: 1rem; }
+.catalogue-preview-content { padding: calc(var(--catalogue-space) * 4); }
+.catalogue-preview-footer {
+  margin-top: calc(var(--catalogue-space) * 6);
+  padding: calc(var(--catalogue-space) * 4);
+  text-align: center;
+  overflow-wrap: anywhere;
+}
+
+/* Keep the phone chat launcher clear of catalogue prices and actions. */
+@media (max-width: 479px) {
+  body:has(.catalogue-page):has(.chat-launcher-lift) .catalogue-brand {
+    max-width: calc(100% - 64px);
+    flex-wrap: wrap;
+    gap: 12px;
+  }
+
+  body:has(.catalogue-page):has(.chat-launcher-lift) .catalogue-brand > div {
+    flex: 1 1 8rem;
+  }
+
+  body:has(.catalogue-page):has(.chat-launcher-lift) .catalogue-brand img,
+  body:has(.catalogue-page):has(.chat-launcher-lift) .catalogue-monogram {
+    max-width: 44px;
+    max-height: 44px;
+  }
+
+  body:has(.catalogue-page) .chat-launcher-lift {
+    top: 0.75rem;
+    right: 1rem;
+    bottom: auto;
+  }
+
+  body:has(.catalogue-page) .chat-launcher-lift button {
+    width: 44px;
+    height: 44px;
+  }
+}
+
+@media (min-width: 768px) {
+  .catalogue-page { padding-block: calc(var(--catalogue-space) * 8); }
+  .catalogue-page .catalogue-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .catalogue-page .catalogue-photo { aspect-ratio: 2 / 1; }
+}
+
+@media (min-width: 1280px) {
+  .catalogue-page .catalogue-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@container (min-width: 640px) {
+  .catalogue-preview .catalogue-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .catalogue-preview .catalogue-photo { aspect-ratio: 2 / 1; }
+}
+
+@container (min-width: 900px) {
+  .catalogue-preview .catalogue-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (hover: hover) {
+  .catalogue-card:hover {
+    border-color: color-mix(in srgb, var(--cfg-hover) 65%, var(--catalogue-ink, var(--ink)));
+  }
+  .catalogue-action:hover { text-decoration: underline; text-underline-offset: 0.2em; }
+  .catalogue-nav a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
+}
