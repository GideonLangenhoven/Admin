--ck-text)\" }}>{v.recipient_name || \"-\"}</td>\n                        <td className=\"hidden p-3 text-xs md:table-cell\" style={{ color: \"var(--ck-text-muted)\" }}>\n                          {v.buyer_name || \"-\"}\n                          <br />\n                          {v.buyer_email || \"\"}\n                        </td>\n                        <td className=\"hidden p-3 text-xs lg:table-cell\" style={{ color: \"var(--ck-text-muted)\" }}>{v.expires_at ? new Date(v.expires_at).toLocaleDateString(\"en-ZA\") : \"-\"}</td>\n                        <td className=\"hidden p-3 text-xs lg:table-cell\" style={{ color: \"var(--ck-text-muted)\" }}>{v.created_at ? new Date(v.created_at).toLocaleDateString(\"en-ZA\") : \"-\"}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/app/vouchers/voucher-purchase.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/app/whatsapp-privacy/page.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":38,"column":62,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[1514,1934],"text":"\n              This Privacy Policy explains how BookingTours (&quot;we\", \"us\", \"our\") collects, uses, processes, \n              and protects personal information collected via our WhatsApp booking bot assistant. \n              The WhatsApp bot is a white-label integration provided by BookingTours to authorized tour operators \n    