value) => Number(value)).filter((value) => Number.isFinite(value));\n  } catch {\n    return [];\n  }\n}\n\nconst targetPort = 3000;\nconst initialPids = getPortPids(targetPort);\n\nconst killResults = [];\nfor (const pid of initialPids) {\n  try {\n    process.kill(pid, \"SIGKILL\");\n    killResults.push({ pid, killed: true });\n  } catch (error) {\n    const message = error instanceof Error ? error.message : \"unknown\";\n    killResults.push({ pid, killed: false, error: message });\n  }\n}\n\nconst remainingPids = getPortPids(targetPort);\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/provision-demo-account.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/recreate_templates.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/release-evidence-check.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/release-monitoring.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/release-platform-check.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/scripts/release-sql.mjs","messages":[],"suppressedMessages":[],"error