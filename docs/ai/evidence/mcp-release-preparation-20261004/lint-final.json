sabled={!isPrivileged}\n        />\n      </div>\n\n      <div className=\"mt-6 rounded-xl border p-4\" style={{ borderColor: \"var(--ck-border-subtle)\", background: \"var(--ck-surface-sunken)\" }}>\n        <div className=\"flex flex-wrap items-start justify-between gap-3\">\n          <div>\n            <h4 className=\"text-sm font-semibold\" style={{ color: \"var(--ck-text-strong)\" }}>WhatsApp support hours</h4>\n            <p className=\"mt-1 text-xs\" style={{ color: \"var(--ck-text-muted)\" }}>\n              When set to outside-hours mode, the assistant replies outside these times.\n            </p>\n          </div>\n          <span className=\"rounded-full px-2.5 py-1 text-[11px] font-medium\" style={{ background: \"rgba(16, 185, 129, 0.12)\", color: \"var(--ck-accent)\" }}>\n            {state.timezone || \"UTC\"}\n          </span>\n        </div>\n\n        <div className=\"mt-4 space-y-2\">\n          {DAY_KEYS.map(day => {\n            const hours = hoursDraft[day];\n            return (\n              <div key={day} className=\"grid gap-3 rounded-lg border p-3 sm:grid-cols-[minmax(110px,1fr)_auto_auto_auto]\" style={{ borderColor: \"var(--ck-border-subtle)\", background: \"var(--ck-surface)\" }}>\n                <label className=\"flex items-center gap-2 text-sm font-medium\" style={{ color: \"var(--ck-text-strong)\" }}>\n                  <input\n                    type=\"checkbox\"\n                    checked={!hours.closed}\n                    disabled={!isPrivileged}\n                    onChange={(e) => updateDay(day, { closed: !e.target.checked })}\n                    className=\"accent-emerald-600\"\n                  />\n                  {DAY_LABELS[day]}\n                </label>\n                <label className=\"grid gap-1 text-[11px] font-medium uppercase tracking-wide\" style={{ color: \"var(--ck-text-muted)\" }}>\n                  Opens\n                  <input\n                    type=\"time\"\n                    value={hours.open}\n                    disabled={!isPrivileged || hours.closed}\n                    onChange={(e) => updateDay(day, { open: e.target.value })}\n                    className=\"h-9 rounded-lg border px-2 text-sm normal-case\"\n                    style={{ borderColor: \"var(--ck-border-subtle)\", background: \"var(--ck-bg)\", color: \"var(--ck-text)\" }}\n                  />\n                </label>\n                <label className=\"grid gap-1 text-[11px] font-medium uppercase tracking-wide\" style={{ color: \"var(--ck-text-muted)\" }}>\n                  Closes\n                  <input\n                    type=\"time\"\n                    value={hours.close}\n                    disabled={!isPrivileged || hours.closed}\n                    onChange={(e) => updateDay(day, { close: e.target.value })}\n                    className=\"h-9 rounded-lg border px-2 text-sm normal-case\"\n                    style={{ borderColor: \"var(--ck-border-subtle)\", background: \"var(--ck-bg)\", color: \"var(--ck-text)\" }}\n                  />\n                </label>\n                <div className=\"flex items-end text-xs\" style={{ color: \"var(--ck-text-muted)\" }}>\n                  {hours.closed ? \"Closed all day\" : `${hours.open} to ${hours.close}`}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {isPrivileged ? (\n        <button data-demo-action=\"whatsapp.save\"\n          onClick={save}\n          disabled={!readOnly && !canSave}\n          className=\"mt-6 rounded-xl px-6 py-3 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50\"\n        >\n          {saving ? \"Saving...\" : \"Save changes\"}\n        </button>\n      ) : (\n        <p className=\"mt-4 text-xs\" style={{ color: \"var(--ck-text-muted)\" }}>\n          Only the main admin can change this setting.\n        </p>\n      )}\n\n      {state.mode === \"OUTSIDE_HOURS\" && hasSavedBusinessHours && (\n        <p className=\"mt-4 text-xs\" style={{ color: \"var(--ck-text-muted)\" }}>\n          The assistant uses these support hours to decide when to reply.\n        </p>\n      )}\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/bookingtours-mcp-20261003/candidate/app/settings/ota/page.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":1,"message":"Error: Cannot access variable before it is declared\n\n`refreshAll` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n/private/tmp/bookingtours-mcp-20261003/candidate/app/settings/ota/page.tsx:74:21\n  72 |\n  73 |   useEffect(() => {\n> 74 |     if (businessId) refreshAll();\n     |                     ^^^^^^^^^^ `refreshAll` accessed before it is declared\n  75 |   }, [businessId]);\n  76 |\n  77 |   useEffect(() => {\n\n/private/tmp/bookingtours-mcp-20261003/candidate/app/settings/ota/page.tsx:90:3\n   88 |   }\n   89 |\n>  90 |   async function refreshAll() {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  91 |     const [toursRes] = await Promise.all([\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  92 |       supabase.from(\"tours\").select(\"id, name\").eq(\"business_id\", businessId).order(\"name\"),\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  93 |     ]);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  94 |     setTours((toursRes.data as Tour[]) || []);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  95 |     for (const ch of CHANNELS) {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  96 |       await refreshChannel(ch.key);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  97 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  98 |   }\n      | ^^^^ `refreshAll` is declared here\n   99 |\n  100 |   async function refreshChannel(channel: string) {\n  101 |     const headers = await authHeaders();","line":74,"column":21,"nodeT